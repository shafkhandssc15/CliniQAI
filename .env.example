# CliniQ AI — Environment Configuration Example

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your_publishable_or_anon_key

# Optional API Keys for Cloud VLM Engines
NVIDIA_API_KEY=nvapi-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# JWT Secret Key (generate 32+ random characters for production)
CLINIQ_SECRET_KEY=your-secret-key-change-in-production-32chars
